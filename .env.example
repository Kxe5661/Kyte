# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model to use (free tier works with flash models).
# List what's available to your key: visit http://localhost:3171/api/models after starting.
GEMINI_MODEL=gemini-3.8-flash

# Cloud model. When XAI_API_KEY is set, Kyte uses Grok instead of Gemini.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Everyday jobs use the model loaded in LM Studio ($0).
# Checkout, forms, and a stuck local step still use Gemini.
# If LM Studio is closed, Kyte falls back to Ollama.
# LLM_ROUTE=balance | local | google
LMSTUDIO_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=google/gemma-4-e4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:27b
LLM_ROUTE=balance

# Port the Kyte server listens on
PORT=3171

# Kyte keeps its own address book in data/contacts.json.
# It does NOT read macOS Contacts (that would make Cursor ask for permission).

# Password required to connect from your phone/browser.
# Leave blank and Kyte will generate one for you on first launch.
KYTE_PASSWORD=
